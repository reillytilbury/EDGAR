import numpy as np
def parameter_estimator(stimuli, spike_counts):
    """Estimates parameters for neuron_model_v3 based on rate map analysis and vector statistics.
    
    The estimator builds upon parameter_estimator_v2 with improved estimation of sigma values 
    by considering the spread of activity in the x and y dimensions. It adds logic for inferring 
    the place field coupling (interaction between fields) based on the co-activity. The goal is to more
    robustly capture field centers, directional preferences, and speed modulations, especially 
    when fields are non-isotropic or show interactions as seen in cells on the image (particularly last cells).

    The improvements attempt to address the following common errors by parameter:
      - **center_x_i, center_y_i:** Field locations refined based on initial rate map.  Still needs improvements (bayesian model needed to reduce uncertainty).
      - **place_amp_i:** Field amplitudes adjusted by overall spiking levels and variance.
      - **sigma_x_i, sigma_y_i:** Now estimated to address non-circular receptive fields (anisotropy) which affect fits as indicated in previous step analysis
      - **hd_pref, hd_amp:** Head direction estimated, but some cells indicate there is potential misestimations to work on in the future
      - **speed_gain, speed_exp:** Retained estimation from prior model versions. Seems decent in that direction but must test.
      - **place_coupling**: Needs more improvements;

    Returns: [center_x_1, center_y_1, place_amp_1, sigma_x_1, sigma_y_1, center_x_2, center_y_2, place_amp_2, sigma_x_2, sigma_y_2, baseline, hd_pref, hd_amp, speed_gain, speed_exp, place_coupling]
    """
    from scipy.ndimage import gaussian_filter, maximum_filter

    def _rate_map(pos_xy, spikes, bins=40, min_occ=3, smoothing_sigma=1.2):
        H, xedges, yedges = np.histogram2d(pos_xy[:, 0], pos_xy[:, 1], bins=bins)
        H_s, _, _ = np.histogram2d(pos_xy[:, 0], pos_xy[:, 1], bins=[xedges, yedges], weights=spikes)
        H_occupancy = H.copy()
        occupancy_filter = H > min_occ
        with np.errstate(divide='ignore', invalid='ignore'):
            H = np.where(H_occupancy > min_occ, H_s / (H + 1e-12), np.zeros_like(H))
        H = gaussian_filter(H, sigma=smoothing_sigma)
        return H.T, xedges, yedges

    stim = np.asarray(stimuli)
    pos = stim[:, :2]
    hd = stim[:, 2] if stim.shape[1] > 2 else np.zeros(len(stim))
    speed = stim[:, 3] if stim.shape[1] > 3 else np.zeros(len(stim))
    spikes = np.asarray(spike_counts)
    rate, xedges, yedges = _rate_map(pos, spikes, bins=40, smoothing_sigma=1.2)
    finite = np.isfinite(rate)
    if not np.any(finite):
        return np.zeros(16)
    baseline = float(np.percentile(rate, 10))
    rate = np.nan_to_num(rate, nan=baseline)
    maxima = maximum_filter(rate, footprint=np.ones((3, 3)), mode='constant', cval=0.0)
    peaks = (maxima == rate) & (rate > baseline)
    peak_indices = np.argwhere(peaks)

    x_centers = 0.5 * (xedges[:-1] + xedges[1:])
    y_centers = 0.5 * (yedges[:-1] + yedges[1:])
    if peak_indices.shape[0] >= 2:
        peak_vals = np.array([rate[i, j] for i, j in peak_indices])
        top_peaks = peak_indices[np.argsort(peak_vals)[::-1][:2]]
        iy1, ix1 = top_peaks[0]
        iy2, ix2 = top_peaks[1]
    else:
        max_idx = np.unravel_index(np.argmax(rate), rate.shape)
        iy1, ix1 = max_idx
        iy2, ix2 = ix1, iy1
    center1 = np.array([x_centers[ix1], y_centers[iy1]])
    center2 = np.array([x_centers[ix2], y_centers[iy2]])
    amp1 = float(rate[iy1, ix1] - baseline)
    amp2 = float(rate[iy2, ix2] - baseline)

    yy, xx = np.meshgrid(y_centers, x_centers, indexing="ij")
    weights = np.clip(rate - baseline, 0.0, None)
    weights = np.nan_to_num(weights, nan=0.0)
    wsum = np.sum(weights) + 1e-8
    var_x1 = np.sum(((xx - center1[0]) ** 2) * weights) / wsum
    var_y1 = np.sum(((yy - center1[1]) ** 2) * weights) / wsum
    var_x2 = np.sum(((xx - center2[0]) ** 2) * weights) / wsum
    var_y2 = np.sum(((yy - center2[1]) ** 2) * weights) / wsum

    sigma_x1 = float(np.sqrt(var_x1))
    sigma_y1 = float(np.sqrt(var_y1))
    sigma_x2 = float(np.sqrt(var_x2))
    sigma_y2 = float(np.sqrt(var_y2))

    active_hd = hd[spikes > baseline]
    if len(active_hd) > 0:
        hd_pref = float(np.arctan2(np.mean(np.sin(active_hd)), np.mean(np.cos(active_hd))))
    else:
        hd_pref = 0.0
    hd_amp = 0.5
    if np.sum(spikes > baseline) > 10:
        speed_threshold = np.quantile(speed[spikes > baseline], 0.25)
        active = (spikes > baseline) & (speed > speed_threshold)

        if np.sum(active) > 5:
            mean_speed = np.mean(speed[active])
            mean_spikes = np.mean(spikes[active]) - baseline

            if mean_speed > 0:
                correction_factor = np.clip(np.ptp(spikes) / np.ptp(speed), 0.1, 5) 
                speed_gain = mean_spikes / (mean_speed + 1e-6) * correction_factor
                speed_exp = 1.0 
            else:
                speed_gain = 0.0
                speed_exp = 1.0
        else:
            speed_gain = 0.0
            speed_exp = 1.0
    else:
        speed_gain = 0.0
        speed_exp = 1.0

    place1 = np.exp(-0.5 * ((pos[:,0] - center1[0])**2 / sigma_x1**2 + (pos[:,1] - center1[1])**2 / sigma_y1**2))
    place2 = np.exp(-0.5 * ((pos[:,0] - center2[0])**2 / sigma_x2**2 + (pos[:,1] - center2[1])**2 / sigma_y2**2))

    #Estimate place coupling based on observed co-activity in spiking
    coupling = np.mean((spikes - baseline) * place1 * place2) / (np.std(place1*place2) + 1e-6) #check math, clip
    coupling = np.clip(coupling, -1.0, 1.0)
    
    return np.array([center1[0], center1[1], amp1, sigma_x1, sigma_y1, center2[0], center2[1], amp2, sigma_x2, sigma_y2, baseline, hd_pref, hd_amp, speed_gain, speed_exp, coupling])

