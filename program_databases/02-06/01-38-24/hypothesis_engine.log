import numpy as np
def neuron_model_v3(stimuli,
                    # Field 1 parameters
                    center_x_1=0.25,
                    center_y_1=0.25,
                    place_amp_1=1.0,
                    sigma_x_1=1.0,
                    sigma_y_1=1.0,
                    # Field 2 parameters
                    center_x_2=0.75,
                    center_y_2=0.75,
                    place_amp_2=1.0,
                    sigma_x_2=1.0,
                    sigma_y_2=1.0,
                    # Modulation parameters
                    baseline=0.0,
                    hd_pref=0.0,
                    hd_amp=0.5,
                    speed_gain=0.0,
                    speed_exp = 1.0,
                    #HD offset and gain
                    hd_offset = 0.0,
                    hd_power = 1.0):
    """
    Parent Models:
    - v1: Single place field with simple head-direction and speed modulation.
    - v2: Two anisotropic Gaussian place fields with multiplicative head-direction (HD) and additive speed modulation.

    This model combines features from v1 and v2 and introduces a power function for the head direction.

    rate = baseline + (G_1 + G_2) * (1 + hd_amp * cos(hd - hd_pref))^hd_power + speed_gain * speed^speed_exp
    where G_i is an anisotropic 2D Gaussian for field i.

    Compared to v2, this model introduces hd_power to allow the HD modulation to be non-linear.
    This is motivated by the image analysis, which reveals in rows 2, 3, and 4 that the hd tuning
    can be stronger or weaker than the default cosinusoidal profile would allow. By adding hd_power, the hd_amp can be lower,
    while allowing a stronger influence of HD when hd is near the hd_pref.

    """
    # Clip parameters to plausible ranges
    place_amp_1 = np.clip(place_amp_1, 0.0, None)
    sigma_x_1 = np.clip(sigma_x_1, 1e-6, None)
    sigma_y_1 = np.clip(sigma_y_1, 1e-6, None)
    place_amp_2 = np.clip(place_amp_2, 0.0, None)
    sigma_x_2 = np.clip(sigma_x_2, 1e-6, None)
    sigma_y_2 = np.clip(sigma_y_2, 1e-6, None)
    baseline = np.clip(baseline, 0.0, None)
    hd_amp = np.clip(hd_amp, 0.0, 1.0)
    speed_gain = np.clip(speed_gain, 0.0, None)
    speed_exp = np.clip(speed_exp, 0.0, 5.0)
    hd_power = np.clip(hd_power, 0.0, 5.0)

    # Unpack stimuli
    stim = np.asarray(stimuli)
    x = stim[:, 0]
    y = stim[:, 1]
    hd = stim[:, 2] if stim.shape[1] > 2 else 0.0
    speed = stim[:, 3] if stim.shape[1] > 3 else 0.0

    # Calculate place field 1
    dx1 = x - center_x_1
    dy1 = y - center_y_1
    r2_1 = (dx1 ** 2) / (sigma_x_1 ** 2) + (dy1 ** 2) / (sigma_y_1 ** 2)
    place_1 = place_amp_1 * np.exp(-0.5 * r2_1)

    # Calculate place field 2
    dx2 = x - center_x_2
    dy2 = y - center_y_2
    r2_2 = (dx2 ** 2) / (sigma_x_2 ** 2) + (dy2 ** 2) / (sigma_y_2 ** 2)
    place_2 = place_amp_2 * np.exp(-0.5 * r2_2)

    total_place = place_1 + place_2

    # Calculate multiplicative HD modulation
    hd_modulation = (1.0 + hd_amp * np.cos(hd - hd_pref))**hd_power

    # Calculate speed modulation
    speed_modulation = speed_gain * speed**speed_exp

    # Combine terms
    rate = baseline + total_place * hd_modulation + speed_modulation

    return rate




