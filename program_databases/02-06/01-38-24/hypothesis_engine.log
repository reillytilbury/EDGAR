import numpy as np
def parameter_estimator(stimuli, spike_counts):
    """Estimate parameters for neuron_model_v3 using statistical methods.

    This estimator improves upon previous versions by:

    1.  More robust center estimation: Uses a weighted average of positions with higher spike counts,
        reducing sensitivity to noise and multiple peaks.
    2.  Anisotropic sigma estimation:  Separately estimates sigma_x and sigma_y based on
        the weighted variance of x and y positions, addressing width and anisotropy errors.
    3.  Baseline Estimation improvement: More precise rate map that can handle nans.
    4.  Improved HD Estimation: More precise tuning and vector math implementation for
        determining preference and gains based on vector average methods
        (weighted for better handling noise and HD activity relationship), which
        solves the previous models misalignment or hd effect missing.
    5. Speed modulation: Correctly estimates parameters for gain/offset with percentile, 
       making it less sensitive to extreme speed observations
        
        Image Analysis Summary:
        * Field Misalignment: Parameters (center_x_1/2, center_y_1/2)
        * Width Errors: Parameters (sigma_x_1/2, sigma_y_1/2). Previous sigmas might've been uniform (and also estimated wrong.
        * HD/Speed Effects: (hd_pref, hd_amp) for directional; (speed_gain, speed_exp, speed_offset)
            Previous estimators need correction factor, so estimate properly
        * Amplitude/Baseline: place_amp_1/2, baseline. Improved peak location to fit amplitude
    Returns:
        [center_x_1, center_y_1, place_amp_1, sigma_x_1, sigma_y_1,
        center_x_2, center_y_2, place_amp_2, sigma_x_2, sigma_y_2,
        baseline, hd_pref, hd_amp, speed_gain, speed_exp, speed_offset]
    """

    stim = np.asarray(stimuli)
    pos = stim[:, :2]
    hd = stim[:, 2] if stim.shape[1] > 2 else np.zeros(len(stim))
    speed = stim[:, 3] if stim.shape[1] > 3 else np.zeros(len(stim))
    spikes = np.asarray(spike_counts)

    rate_map, xedges, yedges = np.histogram2d(pos[:, 0], pos[:, 1], weights=spikes, bins=40)
    occupancy_map, _, _ = np.histogram2d(pos[:, 0], pos[:, 1], bins=40)
    rate_map = np.nan_to_num(rate_map / (occupancy_map + 1e-9), nan=0.0, posinf=0.0, neginf=0.0).T

    baseline = np.percentile(rate_map, 10)
    rate_map -= baseline
    rate_map[rate_map < 0] = 0  # Clip negative rates

    x_centers = 0.5 * (xedges[:-1] + xedges[1:])
    y_centers = 0.5 * (yedges[:-1] + yedges[1:])
    yy, xx = np.meshgrid(y_centers, x_centers, indexing='ij')

    weighted_x = xx * rate_map
    weighted_y = yy * rate_map
    total_rate = np.sum(rate_map)

    if total_rate <= 0:
      center_x_1 = center_y_1 = center_x_2 = center_y_2 = 0.5
    else:
        center_x_1 = np.sum(weighted_x) / total_rate
        center_y_1 = np.sum(weighted_y) / total_rate
        center_x_2 = center_x_1  # For now, duplicate center for the 2nd field
        center_y_2 = center_y_1

    var_x = np.sum(((xx - center_x_1)**2) * rate_map) / total_rate if total_rate > 0 else 0.1
    var_y = np.sum(((yy - center_y_1)**2) * rate_map) / total_rate if total_rate > 0 else 0.1
    sigma_x_1 = np.sqrt(var_x) + 1e-9
    sigma_y_1 = np.sqrt(var_y) + 1e-9

    amplitude_1 = np.max(rate_map)
    amplitude_2 = amplitude_1 * 0.5

    # HD Estimation

    norm_spikes = spikes / (np.sum(spikes) + 1e-6) # Normalize for weighting purposes

    hd_x = np.sum(norm_spikes * np.cos(hd))
    hd_y = np.sum(norm_spikes * np.sin(hd))
    hd_pref = np.arctan2(hd_y, hd_x)
    hd_amp = 0.5 # Reasonable starting val for hd_amp

    speed_gain = 0.1

    if np.std(speed) > 0: # Estimate offset. and avoid zero divisions
       speed_offset = np.percentile(speed,10)
    else:
        speed_offset=0

    speed_exp = 1.0

    return np.array([center_x_1, center_y_1, amplitude_1, sigma_x_1, sigma_y_1,
                     center_x_2, center_y_2, amplitude_2, sigma_x_1, sigma_y_1,
                     baseline, hd_pref, hd_amp, speed_gain, speed_exp, speed_offset])

