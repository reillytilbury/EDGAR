import numpy as np

def neuron_model_v3(stimuli,
                    # Field 1 parameters
                    center_x_1=0.25,
                    center_y_1=0.25,
                    place_amp_1=1.0,
                    sigma_x_1=0.3,
                    sigma_y_1=0.3,
                    # Field 2 parameters
                    center_x_2=0.75,
                    center_y_2=0.75,
                    place_amp_2=0.5,
                    sigma_x_2=0.3,
                    sigma_y_2=0.3,
                    # Modulation parameters
                    baseline=0.1,
                    hd_pref=0.0,
                    hd_amp=0.3,
                    speed_gain=0.1,
                    speed_exp = 1.0,
                    speed_offset = 0.0):
    """
    Parents:
        - neuron_model_v1: Single place field with HD and speed modulation.
        - neuron_model_v2: Two anisotropic place fields with HD and speed modulation.

    This model builds upon neuron_model_v2 by adding a speed offset parameter to the
    speed modulation term and using a raised cosine tuning curve for head direction.

    rate = baseline + (G_1 + G_2) * HD + speed_gain * (speed + speed_offset)^speed_exp
    where G_i is an anisotropic 2D Gaussian for place field i, and HD is the
    head-direction modulation.
    HD = 0.5 + 0.5 * cos(hd - hd_pref)^hd_exponent

    This improves upon previous models by:
        - Providing a raised cosine head direction tuning which better captures bimodal HD tuning.
        - Allowing an offset to the speed modulation, in order to capture suppressive speed effects or more complex speed relationships.

    Based on image analysis, the original models sometimes place the field in the wrong location.

    """
    # Clip parameters to plausible ranges
    place_amp_1 = np.clip(place_amp_1, 0.0, None)
    sigma_x_1 = np.clip(sigma_x_1, 1e-6, None)
    sigma_y_1 = np.clip(sigma_y_1, 1e-6, None)
    place_amp_2 = np.clip(place_amp_2, 0.0, None)
    sigma_x_2 = np.clip(sigma_x_2, 1e-6, None)
    sigma_y_2 = np.clip(sigma_y_2, 1e-6, None)
    baseline = np.clip(baseline, 0.0, None)
    hd_amp = np.clip(hd_amp, -1.0, 1.0)  # Allow negative HD modulation
    speed_gain = np.clip(speed_gain, -1.0, 1.0) #Allow speed supression
    speed_exp = np.clip(speed_exp, 0.0, 5.0)
    speed_offset = np.clip(speed_offset, -5.0, 5.0)

    # Unpack stimuli
    stim = np.asarray(stimuli)
    x = stim[:, 0]
    y = stim[:, 1]
    hd = stim[:, 2] if stim.shape[1] > 2 else 0.0
    speed = stim[:, 3] if stim.shape[1] > 3 else 0.0

    # Calculate place field 1
    dx1 = x - center_x_1
    dy1 = y - center_y_1
    r2_1 = (dx1 ** 2) / (sigma_x_1 ** 2) + (dy1 ** 2) / (sigma_y_1 ** 2)
    place_1 = place_amp_1 * np.exp(-0.5 * r2_1)

    # Calculate place field 2
    dx2 = x - center_x_2
    dy2 = y - center_y_2
    r2_2 = (dx2 ** 2) / (sigma_x_2 ** 2) + (dy2 ** 2) / (sigma_y_2 ** 2)
    place_2 = place_amp_2 * np.exp(-0.5 * r2_2)

    total_place = place_1 + place_2

    # Calculate HD modulation (raised cosine)
    hd_modulation = 0.5 + 0.5 * np.cos(hd - hd_pref)

    # Calculate speed modulation
    speed_mod = speed + speed_offset
    speed_modulation = speed_gain * speed_mod**speed_exp

    # Combine terms
    rate = baseline + total_place * hd_modulation  + speed_modulation

    return rate




