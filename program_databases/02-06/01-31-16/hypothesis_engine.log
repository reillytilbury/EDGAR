import numpy as np

def neuron_model(stimuli,
                    # Field 1 parameters
                    center_x_1=0.25,
                    center_y_1=0.25,
                    place_amp_1=1.0,
                    sigma_x_1=1.0,
                    sigma_y_1=1.0,
                    theta_1 = 0.0,
                    # Field 2 parameters
                    center_x_2=0.75,
                    center_y_2=0.75,
                    place_amp_2=1.0,
                    sigma_x_2=1.0,
                    sigma_y_2=1.0,
                    theta_2 = 0.0,
                    # Modulation parameters
                    baseline=0.0,
                    hd_pref=0.0,
                    hd_amp=0.5,
                    speed_gain=0.0,
                    speed_exp = 1.0):
    """
    `neuron_model_v1`: Single Gaussian with HD/Speed.
    `neuron_model_v2`: Two anisotropic Gaussians with HD/Speed.

    This model extends neuron_model_v2 by adding a rotation parameter
    to each of the anisotropic Gaussians. This allows the model to fit
    elongated place fields that are not aligned with the x or y axis.

    rate = baseline + (G_1 + G_2) * (1 + hd_amp * cos(hd - hd_pref)) + speed_gain * speed^speed_exp
    where G_i is an rotated anisotropic 2D Gaussian for field i.
    The rotation is controlled by the angles theta_1 and theta_2 for the two Gaussians.
    """
    # Clip parameters to plausible ranges
    place_amp_1 = np.clip(place_amp_1, 0.0, None)
    sigma_x_1 = np.clip(sigma_x_1, 1e-6, None)
    sigma_y_1 = np.clip(sigma_y_1, 1e-6, None)
    place_amp_2 = np.clip(place_amp_2, 0.0, None)
    sigma_x_2 = np.clip(sigma_x_2, 1e-6, None)
    sigma_y_2 = np.clip(sigma_y_2, 1e-6, None)
    baseline = np.clip(baseline, 0.0, None)
    hd_amp = np.clip(hd_amp, 0.0, 1.0)
    speed_gain = np.clip(speed_gain, 0.0, None)
    speed_exp = np.clip(speed_exp, 0.0, 5.0)
    theta_1 = np.clip(theta_1, -np.pi, np.pi)
    theta_2 = np.clip(theta_2, -np.pi, np.pi)
    
    # Unpack stimuli
    stim = np.asarray(stimuli)
    x = stim[:, 0]
    y = stim[:, 1]
    hd = stim[:, 2] if stim.shape[1] > 2 else 0.0
    speed = stim[:, 3] if stim.shape[1] > 3 else 0.0

    # Calculate place field 1
    dx1 = x - center_x_1
    dy1 = y - center_y_1

    # Rotation matrix for field 1
    cos_theta_1 = np.cos(theta_1)
    sin_theta_1 = np.sin(theta_1)

    dx_rot_1 = dx1 * cos_theta_1 + dy1 * sin_theta_1
    dy_rot_1 = -dx1 * sin_theta_1 + dy1 * cos_theta_1
    
    r2_1 = (dx_rot_1 ** 2) / (sigma_x_1 ** 2) + (dy_rot_1 ** 2) / (sigma_y_1 ** 2)
    place_1 = place_amp_1 * np.exp(-0.5 * r2_1)

    # Calculate place field 2
    dx2 = x - center_x_2
    dy2 = y - center_y_2
    
    # Rotation matrix for field 2
    cos_theta_2 = np.cos(theta_2)
    sin_theta_2 = np.sin(theta_2)

    dx_rot_2 = dx2 * cos_theta_2 + dy2 * sin_theta_2
    dy_rot_2 = -dx2 * sin_theta_2 + dy2 * cos_theta_2

    r2_2 = (dx_rot_2 ** 2) / (sigma_x_2 ** 2) + (dy_rot_2 ** 2) / (sigma_y_2 ** 2)
    place_2 = place_amp_2 * np.exp(-0.5 * r2_2)

    total_place = place_1 + place_2

    # Calculate multiplicative HD modulation
    hd_modulation = 1.0 + hd_amp * np.cos(hd - hd_pref)
    
    # Calculate speed modulation
    speed_modulation = speed_gain * speed**speed_exp
    
    # Combine terms
    rate = baseline + total_place * hd_modulation + speed_modulation

    return rate

